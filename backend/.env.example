DATABASE_URL=mysql://brikrs:brikrsdev@127.0.0.1:3307/brikrs
BIND_ADDR=127.0.0.1:8080
# ビルド済みフロントエンドの置き場所（無ければAPIのみ）
STATIC_DIR=../frontend/dist
# 本番(HTTPS)では true にする
COOKIE_SECURE=false
# nginx の後ろに置くときだけ true（X-Forwarded-For を信用する）
TRUST_PROXY=false
RUST_LOG=info,sea_orm=warn,sqlx=warn
# アップロード画像の保存先
UPLOAD_DIR=./data/uploads
# サイトごとのアイコン（favicon.ico、icon-192/512.png、apple-touch-icon.png、manifest.webmanifest）
# ここに同じ名前で置くと、同梱の汎用アイコンより優先する（frontend/scripts/make-icons.py で作れる）
BRANDING_DIR=./data/branding
# フィードと共有用のタイトル・説明（OGP）に入れる URL の土台。無ければリクエストの Host から作る
# PUBLIC_URL=https://wiki.example.org
# Web ブックマークの取得で接続しない宛先（このサーバー自身のグローバル IP）。IP・CIDR・ホスト名をカンマか空白区切りで。
# 未設定なら PUBLIC_URL のホスト（取得のたびに名前解決するので IP が変わっても追従する）。空にすると拒否しない。
# PUBLIC_URL が CDN の後ろにあるときは、CDN の IP を拒否しないよう、ここにサーバーの IP を直接書く
# OGP_DENY_IPS=203.0.113.5, 2001:db8::/64
# サイト名の初期値（ロゴ・タブ・フィード・OGP）。管理画面の「サイト」で変えるとそちらが優先される
SITE_NAME=BrikRS
# 認証アプリに表示される名前（2段階認証）
TOTP_ISSUER=BrikRS
# 新しい DB の初回起動でサンプルページ（紹介・使い方・書式・仕様）を作るか
SEED_SAMPLES=true
# 定期的な掃除（6時間ごと）。0 にするとその掃除をしない
# ゴミ箱に入れてから完全に削除するまでの日数
TRASH_RETENTION_DAYS=30
# ページごとに残す履歴の数
REVISION_KEEP=100
# アクセスログ・ログイン試行の記録を残す日数（IP アドレスを含む）
LOG_RETENTION_DAYS=180
# ゲストコメント・リアクションの IP アドレスと User-Agent を残す日数（0 なら無期限）。
# 過ぎたら IP などを消す（コメント・リアクションは残る）。承認されないままのコメントもこの日数で削除する
GUEST_IP_RETENTION_DAYS=90

# 承認待ちのゲストコメントをメールで知らせる（任意。SMTP_SERVER・SMTP_USER・COMMENT_NOTIFY_TO が揃ったときだけ送る）
# SMTP over SSL（暗黙の TLS）。数分ごとにまとめて1通にし、送ったあと30分は送らない
# 設定の確認は brikrs mail-test（試しの1通を送る）
#SMTP_SERVER=mail.example.org
#SMTP_PORT=465
#SMTP_USER=brikrs@example.org
#SMTP_PASSWD=
# 差出人（無ければ SMTP_USER）
#MAIL_FROM=brikrs@example.org
# 通知の宛先（カンマ区切りで複数可）
#COMMENT_NOTIFY_TO=webmaster@example.org
